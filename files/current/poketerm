#!/usr/bin/env zsh
[[ -n "${POKETERM_RUNNING:-}" ]] && return 0
export POKETERM_RUNNING=1
POKETERM_PATH="$HOME/.local/share/poketerm"
POKEDEX_FILE="$HOME/.local/share/poketerm/pokedex.txt"
POKEDEX_HASH="$POKEDEX_FILE.sha256"
SORTED_FILE="$HOME/.local/share/poketerm/pokedex_sorted.txt"
GEN_DIR="$HOME/.local/share/poketerm/gen_files"
VERSION_DIRECTORY="$HOME/.local/share/poketerm/VERSION"
GEN_COLLECTION_DEFAULT="1-8"
GEN_COLLECTION="$GEN_COLLECTION_DEFAULT"

# === MAKE POKEDEX FILE IF IT DOESNT EXIST ===
mkdir -p "$(dirname "$POKEDEX_FILE")"
touch "$POKEDEX_FILE"
chmod 444 "$POKEDEX_FILE"

usage() {
    cat <<'EOF'
poketerm - Pokemon terminal collection tool

Usage:
  poketerm [OPTIONS]

Options:
  -h, --help           Show this help message
  -v, --version        Show poketerm version
  -u, --update         Update to the latest version (see: poketerm --update --help)
  -g, --gen N|N-M      Use a specific generation or range (1–8)
  -r, --remove NAME    Remove a Pokemon from the Pokedex
  -f, --fix-pokedex    Repair Pokedex after removal

Set POKETERM_NO_UPDATE_CHECK=1 to turn off the daily update check.

Examples:
  poketerm --update
  poketerm --version
  poketerm --gen 1
  poketerm --gen 2-5
  poketerm --remove pikachu
  poketerm --fix-pokedex
EOF
}

case "$1" in
    -h|--help)
        usage
        return 0
        ;;
    -v|--version)
        if [[ -f "$VERSION_DIRECTORY" ]]; then
            echo "Version: $(<"$VERSION_DIRECTORY")"
        else
            echo "Version: unknown (reinstall with ./install.sh)"
        fi
        return 0
        ;;
    -u|--update|--upgrade)
        shift
        if [[ ! -f "$POKETERM_PATH/update.sh" ]]; then
            echo "The updater is missing. Reinstall once with: git pull && ./install.sh --update"
            return 1
        fi
        POKETERM_APP_DIR="$POKETERM_PATH" bash "$POKETERM_PATH/update.sh" "$@"
        return $?
        ;;
    -g|--gen)
        gen="$2"

        [[ "$gen" =~ ^[0-9]+(-[0-9]+)?$ ]] || {
            echo "Error: --gen must be N or N-M (1–8)"
            return 1
        }

        IFS=- read -r start end <<< "$gen"
        end=${end:-$start}

        (( start >= 1 && end <= 8 && start <= end )) || {
            echo "Error: generations must be between 1 and 8"
            return 1
        }

        GEN_COLLECTION="$gen"
        ;;
    -r|--remove)
        if [[ -n "$2" ]]; then
            if [[ -f "$POKEDEX_HASH" ]]; then
                if command -v sha256sum >/dev/null 2>&1; then
                    sha256sum -c "$POKEDEX_HASH" >/dev/null 2>&1 || true
                else
                    shasum -a 256 -c "$POKEDEX_HASH" >/dev/null 2>&1 || { echo "Pokedex modified outside poketerm, please use 'poketerm --remove \"YOUR_ADDED_POKEMON\"' to move the manually added pokemon from the pokedex."; return 1; }
                fi
            fi

            if ! grep -Fqi "$2 " "$POKEDEX_FILE"; then
                echo "Pokemon '$2' not found in pokedex"
                return 1
            fi

            chmod 644 "$POKEDEX_FILE"
            grep -Fvi "$2 " "$POKEDEX_FILE" > "$SORTED_FILE" &&
            command mv -f "$SORTED_FILE" "$POKEDEX_FILE"
            chmod 444 "$POKEDEX_FILE"

            if command -v sha256sum >/dev/null 2>&1; then
                sha256sum "$POKEDEX_FILE" > "$POKEDEX_HASH"
            else
                shasum -a 256 "$POKEDEX_FILE" > "$POKEDEX_HASH"
            fi

            return 0
        else 
            echo "ERROR: Please specify a pokemon to remove from the pokedex e.g. poketerm --remove pikachu"
            return 0
        fi
        ;;
    -f|--fix-pokedex)
        if command -v sha256sum >/dev/null 2>&1; then
            sha256sum "$POKEDEX_FILE" > "$POKEDEX_HASH"
        else
            shasum -a 256 "$POKEDEX_FILE" > "$POKEDEX_HASH"
        fi
        return 0
esac

if [[ -f "$POKEDEX_HASH" ]]; then
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -c "$POKEDEX_HASH" >/dev/null 2>&1 || { echo "Pokedex modified outside poketerm, please use 'poketerm --remove \"YOUR_ADDED_POKEMON\"' to move the manually added pokemon from the pokedex."; return 1; }
    else
        shasum -a 256 -c "$POKEDEX_HASH" >/dev/null 2>&1 || { echo "Pokedex modified outside poketerm, please use 'poketerm --remove \"YOUR_ADDED_POKEMON\"' to move the manually added pokemon from the pokedex."; return 1; }
    fi
fi

raw_output=$(pokemon-colorscripts -r $GEN_COLLECTION)
name=$(echo "$raw_output" | head -n 1)

if [[ "$name" == *"(shiny)"* ]]; then
    base_name=$(echo "$name" | sed -e 's/ (shiny)//g')
    raw_output=$(pokemon-colorscripts -n "$base_name")
    name=$(echo "$raw_output" | head -n 1)
    sprite=$(echo "$raw_output" | tail -n +2)
else
    base_name="$name"
    sprite=$(echo "$raw_output" | tail -n +2)
fi

# === SHINY ROLL (1/4096 or 1/10 if THAT generation complete) ===

pokemon_gen=""

for GEN_FILE in "$GEN_DIR"/gen*_list.txt; do
    if grep -qx "$base_name" "$GEN_FILE"; then
        pokemon_gen="$GEN_FILE"
        break
    fi
done

gen_complete=false

if [[ -n "$pokemon_gen" ]]; then
    total=$(wc -l < "$pokemon_gen")

    caught=$(awk '
        NR==FNR { gen[$0]=1; next }
        {
            n=$0
            sub(/[ \t]+[0-9]+$/, "", n)
            sub(/ \(shiny\)$/, "", n)
            if (n in gen) seen[n]=1
        }
        END { print length(seen) }
    ' "$pokemon_gen" "$POKEDEX_FILE")

    (( caught == total )) && gen_complete=true
fi

if $gen_complete; then
    (( RANDOM % 10 == 0 )) && shiny=true || shiny=false
else
    (( RANDOM % 4096 == 0 )) && shiny=true || shiny=false
fi

# === FETCH SHINY IF NEEDED ===
if [ "$shiny" = true ]; then
    raw_output=$(pokemon-colorscripts -n "$base_name" -s)
    sprite=$(echo "$raw_output" | tail -n +2)
fi

# === FORMAT NAME FOR POKEDEX STORAGE ===
if [ "$shiny" = true ]; then
    stored_name="${base_name} (shiny)"
    display_name=$'\033[33m'"${base_name} (shiny)"$'\033[0m'
else
    stored_name="$base_name"
    display_name="$base_name"
fi

chmod 644 "$POKEDEX_FILE"

# === UPDATE POKEDEX WITH COUNT ===
awk -v n="$stored_name" '
{
    if ($NF ~ /^[0-9]+$/) {
        count = $NF
        name = substr($0, 1, length($0)-length($NF))
        sub(/[ \t]+$/, "", name)
    } else {
        name = $0
        count = 0
    }

    if (name == n) {
        count++
        found=1
    }

    print name, count
}
END {
    if (!found) print n,1
}
' "$POKEDEX_FILE" > "$SORTED_FILE" && command mv -f "$SORTED_FILE" "$POKEDEX_FILE"

# === SORT POKEDEX BY GENERATION ORDER ===
for GEN_FILE in "$GEN_DIR"/gen*_list.txt; do
    if grep -qx "$base_name" "$GEN_FILE"; then
        awk '
            NR==FNR { order[$0]=NR; next }
            {
                line=$0
                base=$0
                sub(/ \(shiny\)$/, "", base)
                sort_order = (base in order) ? order[base] : 9999
                print sort_order "\t" line
            }
        ' "$GEN_FILE" "$POKEDEX_FILE" \
        | sort -n \
        | cut -f2- > "$SORTED_FILE"
        command mv -f "$SORTED_FILE" "$POKEDEX_FILE"
        break
    fi
done

chmod 444 "$POKEDEX_FILE"

if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$POKEDEX_FILE" > "$POKEDEX_HASH"
else
    shasum -a 256 "$POKEDEX_FILE" > "$POKEDEX_HASH"
fi

# === AWARD XP + CHECK ACHIEVEMENTS ===
# Runs after the pokedex is updated so achievements count this catch.
# Normal: 10 XP | Shiny: 150 XP
if [ "$shiny" = true ]; then
    xp_to_add=150
else
    xp_to_add=10
fi

PYTHONPATH="$POKETERM_PATH" python3 - "$xp_to_add" <<'PY' >/dev/null 2>&1
from trainer import add_xp, update_streak
from achievements import check_pokedex_achievements, update_daily_catch
import sys

add_xp(int(sys.argv[1]))
update_streak()
update_daily_catch()
check_pokedex_achievements()
PY

# === SHOW POKEMON + NEOFETCH INFO ===
# Sprite (with the Pokemon's name underneath) on the left; on the right the
# username, an underline the same length as the username, then system details.

() {
    setopt localoptions extendedglob

    local ansi_re=$'\e''\[[0-9;?]#[a-zA-Z]'
    local user_name="${USER:-$(whoami 2>/dev/null || echo unknown)}"
    local fetch_cmd="" fetch_cfg="" fetch_out="" line plain
    local -a sprite_lines info_lines

    if command -v neofetch >/dev/null 2>&1; then
        fetch_cmd=neofetch
    elif command -v neowofetch >/dev/null 2>&1; then
        fetch_cmd=neowofetch
    fi

    if [[ -n "$fetch_cmd" ]]; then
        fetch_cfg="$(mktemp)"
        cat > "$fetch_cfg" <<'EOF'
print_info() {
    info "OS" distro
    info "Host" model
    info "Kernel" kernel
    info "Uptime" uptime
    info "Packages" packages
    info "Shell" shell
    info "Terminal" term
}
EOF
        fetch_out="$(POKETERM_RUNNING=1 "$fetch_cmd" --config "$fetch_cfg" --off 2>/dev/null)"
        command rm -f -- "$fetch_cfg"
    fi

    info_lines=(
        $'\e[38;5;81m'"${user_name}"$'\e[0m'
        "${(l:${#user_name}::-:)}"
    )
    for line in "${(@f)fetch_out}"; do
        # Drop neofetch's cursor / line-wrap toggles and its leading padding.
        line="${line//$'\e'\[\?[0-9]#[hl]/}"
        line="${line##[[:space:]]#}"
        plain="${line//${~ansi_re}/}"
        [[ -z "${plain//[[:space:]]/}" ]] && continue
        info_lines+=("$line")
    done

    sprite_lines=("${(@f)sprite}")
    while (( ${#sprite_lines} )) && [[ -z "${${sprite_lines[-1]//${~ansi_re}/}//[[:space:]]/}" ]]; do
        sprite_lines[-1]=()
    done
    sprite_lines+=("" "$display_name")

    # Measure ANSI-stripped width in characters so the multibyte block glyphs
    # in the sprite don't inflate the gap.
    local -i sprite_width=0 pad i rows gap=3
    for line in "${sprite_lines[@]}"; do
        plain="${line//${~ansi_re}/}"
        (( ${#plain} > sprite_width )) && sprite_width=${#plain}
    done

    rows=$(( ${#sprite_lines} > ${#info_lines} ? ${#sprite_lines} : ${#info_lines} ))
    for (( i = 1; i <= rows; i++ )); do
        line="${sprite_lines[i]:-}"
        plain="${line//${~ansi_re}/}"
        pad=$(( sprite_width - ${#plain} + gap ))
        printf '%s\e[0m%*s%s\e[0m\n' "$line" "$pad" "" "${info_lines[i]:-}"
    done
}

# === UPDATE NOTICE ===
# Reads a cached result so startup never waits on the network; the cache is
# refreshed in the background at most once a day.
() {
    [[ -n "${POKETERM_NO_UPDATE_CHECK:-}" || ! -f "$POKETERM_PATH/update.sh" ]] && return 0

    local check_file="$POKETERM_PATH/.update_check"
    local checked_at=0 latest="" newer=0
    [[ -r "$check_file" ]] && read -r checked_at latest newer < "$check_file"
    [[ "$checked_at" == <-> ]] || checked_at=0

    if [[ "$newer" == 1 && -n "$latest" ]]; then
        print -P "%F{yellow}✦ Poketerm $latest is available (you have $(<"$VERSION_DIRECTORY" 2>/dev/null)). Run: poketerm --update%f"
    fi

    if (( $(date +%s) - checked_at > 86400 )); then
        # Mark the check as started so parallel terminals don't all hit GitHub.
        print -r -- "$(date +%s) $latest $newer" > "$check_file" 2>/dev/null
        ( POKETERM_APP_DIR="$POKETERM_PATH" bash "$POKETERM_PATH/update.sh" --check --quiet </dev/null >/dev/null 2>&1 & )
    fi
}
